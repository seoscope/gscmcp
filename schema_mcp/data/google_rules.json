{
  "reviewed": "2026-11-24",
  "notes": "Curated rules layered on top of Schema.org. Google rich-result rules were checked against the live developers.google.com pages on the review date. Merchant Center rules map the Merchant Center product data specification onto Schema.org properties and were curated, not machine-extracted. Path syntax: 'a.b' walks nested objects, 'x|y' means any one of them satisfies the rule.",
  "features": [
    {
      "id": "product-snippet",
      "name": "Product snippet (reviews, ratings, price)",
      "layer": "google",
      "modes": [
        "google"
      ],
      "source": "https://developers.google.com/search/docs/appearance/structured-data/product-snippet",
      "reviewed": "2026-11-24",
      "applies_to": [
        "Product"
      ],
      "exclude_subtypes": [
        "ProductGroup"
      ],
      "rules": {
        "Product": {
          "required": [
            "name",
            "review|aggregateRating|offers"
          ],
          "recommended": [
            "aggregateRating",
            "offers",
            "review"
          ]
        },
        "Offer": {
          "required": [
            "price|priceSpecification.price"
          ],
          "recommended": [
            "availability",
            "priceCurrency|priceSpecification.priceCurrency",
            "priceValidUntil"
          ]
        },
        "AggregateOffer": {
          "required": [
            "lowPrice",
            "priceCurrency"
          ],
          "recommended": [
            "highPrice",
            "offerCount"
          ]
        },
        "Review": {
          "required": [
            "author",
            "reviewRating",
            "reviewRating.ratingValue"
          ],
          "recommended": [
            "datePublished",
            "reviewRating.bestRating",
            "reviewRating.worstRating"
          ]
        },
        "AggregateRating": {
          "required": [
            "ratingValue",
            "ratingCount|reviewCount"
          ],
          "recommended": [
            "bestRating",
            "worstRating"
          ]
        }
      }
    },
