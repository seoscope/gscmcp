    {
      "id": "merchant-center",
      "name": "Merchant Center product data (structured data used for automatic item updates and listings)",
      "layer": "merchant-center",
      "modes": [
        "merchant-center"
      ],
      "source": "https://support.google.com/merchants/answer/7052112",
      "reviewed": "2026-11-24",
      "basis": "curated mapping of feed attributes to Schema.org",
      "applies_to": [
        "Product"
      ],
      "exclude_subtypes": [
        "ProductGroup"
      ],
      "rules": {
        "Product": {
          "required": [
            "description"
          ],
          "conditional": [
            {
              "path": "brand.name",
              "when": "Required for all new products except movies, books and music recordings (feed attribute: brand)."
            },
            {
              "path": "gtin|gtin8|gtin12|gtin13|gtin14|isbn|mpn",
              "when": "Provide the GTIN for every product the manufacturer assigned one to; otherwise provide mpn (feed attributes: gtin / mpn)."
            },
            {
              "path": "color",
              "when": "Required for apparel and accessories in some target countries (feed attribute: color)."
            },
            {
              "path": "size",
              "when": "Required for clothing and shoes in some target countries (feed attribute: size)."
            },
            {
              "path": "audience.suggestedGender",
              "when": "Required for apparel in some target countries (feed attribute: gender)."
            }
          ],
          "recommended": []
        },
        "Offer": {
          "required": [
            "availability"
          ],
          "conditional": [
            {
              "path": "itemCondition",
              "when": "Required when the product is used or refurbished (feed attribute: condition)."
            }
          ],
          "recommended": []
        }
      },
      "notes": "Only lists what Merchant Center asks for beyond the Google merchant-listing rich result requirements; validate in merchant-center mode to get both layers."
    },
