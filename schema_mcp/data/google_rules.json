  "comparisons": [
    {
      "types": [
        "Product",
        "ProductGroup"
      ],
      "verdict": "Use ProductGroup when one page (or one family of pages) represents a product that comes in variants such as size, color or material. Mark the shared facts on the ProductGroup (name, brand, description, productGroupID, variesBy) and list each sellable variant as a Product under hasVariant, or point variants back with isVariantOf / inProductGroupWithID. Offers go on the variant Products, never on the ProductGroup, because the group itself is not sold. Use a plain Product when the page sells a single item with no variant selector.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/product-variants"
    },
    {
      "types": [
        "Offer",
        "AggregateOffer"
      ],
      "verdict": "Use Offer when you are the seller: merchant listings accept only Offer. Use AggregateOffer on comparison or aggregator pages that summarise several sellers (lowPrice, highPrice, offerCount); it only qualifies for product snippets.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/merchant-listing"
    },
    {
      "types": [
        "Product",
        "Offer"
      ],
      "verdict": "They are not alternatives. Product describes the item; Offer describes the terms of sale (price, currency, availability, shipping, returns). Nest the Offer in Product.offers.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/merchant-listing"
    },
    {
      "types": [
        "Article",
        "BlogPosting"
      ],
      "verdict": "Google treats Article, NewsArticle and BlogPosting the same for the Article feature. Use the most specific type that is true: BlogPosting for blog posts, NewsArticle for news, Article otherwise.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/article"
    },
    {
      "types": [
        "Article",
        "NewsArticle"
      ],
      "verdict": "Google treats Article, NewsArticle and BlogPosting the same for the Article feature. Use NewsArticle for news reporting and Article for other editorial content.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/article"
    },
    {
      "types": [
        "BlogPosting",
        "NewsArticle"
      ],
      "verdict": "Both are Article subtypes that Google treats identically. Pick by content: news reporting is NewsArticle, blog content is BlogPosting.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/article"
    },
    {
      "types": [
        "Organization",
        "LocalBusiness"
      ],
      "verdict": "LocalBusiness is a subtype of Organization for a physical location customers visit; it requires name and address for the local business feature. Use Organization (or a more specific type such as OnlineStore) on the home or about page for brand-level facts like logo, sameAs and contact points. A brand with stores typically has one Organization plus one LocalBusiness (or a more specific subtype) per location page.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/local-business"
    },
    {
      "types": [
        "Review",
        "AggregateRating"
      ],
      "verdict": "Review is one person's or publication's review with a reviewRating and an author. AggregateRating summarises many ratings (ratingValue plus ratingCount or reviewCount). A product page often carries both: individual Review items and one AggregateRating.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/review-snippet"
    },
    {
      "types": [
        "Person",
        "Organization"
      ],
      "verdict": "Use Person for an individual author or reviewer and Organization for a publisher or company. For Article author, Google asks for the actual author type; do not put a brand name into a Person.",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/article"
    }
  ]
}
